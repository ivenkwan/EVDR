# EVDR environment template — placeholders ONLY. Copy to .env for local use
# (.env is git-ignored; never commit real values). Production values live in
# Vault / masked CI variables, not in this file.

# --- Vault (src/infra/vault) ---
VAULT_ADDR=https://vault.vault.svc:8200
# Bootstrap only; revoked immediately after bootstrap-vault.sh completes.
VAULT_TOKEN=REPLACE_WITH_INIT_ROOT_TOKEN

# --- K3s (src/infra/k3s/scripts) ---
# Shared cluster secret; retrieve from Vault after bootstrap:
#   vault kv get -field=token secret/evdr/k3s/cluster
K3S_TOKEN=REPLACE_FROM_VAULT
K3S_VERSION=v1.32.5+k3s1

# --- CI/CD (GitLab runner, docs/runbooks/gitlab-runner.md) ---
# Base64-encoded staging kubeconfig for the sample deploy job.
KUBECONFIG_B64=REPLACE_WITH_BASE64_KUBECONFIG
