{
  "name": "evdr-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "EVDR frontend monorepo — external portal + admin console (Next.js 15, App Router, TypeScript)",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @evdr/portal --filter @evdr/admin run dev",
    "dev:portal": "pnpm --filter @evdr/portal run dev",
    "dev:admin": "pnpm --filter @evdr/admin run dev",
    "build": "pnpm --filter @evdr/portal run build && pnpm --filter @evdr/admin run build",
    "build:portal": "pnpm --filter @evdr/portal run build",
    "build:admin": "pnpm --filter @evdr/admin run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm --filter @evdr/portal --filter @evdr/admin run lint"
  }
}
