# Base URL of the EVDR API gateway. Same-origin BFF by default — the admin
# console talks to its own route handlers (/api/v1/**), which proxy the Room
# Service server-side. Never point browsers at the Room Service directly.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Room Service (server-side only — used by BFF route handlers, never exposed
# to the browser). ROOM_SERVICE_TOKEN is the Room Service dev shared secret
# (matches EVDR_ROOM_SERVICE_DEV_SECRET in src/services/room/cmd/roomd).
# Production replaces it with service-to-service OIDC (TR-6.x).
ROOM_SERVICE_URL=http://localhost:8080
ROOM_SERVICE_TOKEN=
