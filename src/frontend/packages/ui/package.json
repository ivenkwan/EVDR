{
  "name": "@evdr/ui",
  "version": "0.1.0",
  "private": true,
  "description": "EVDR shared UI kit — shadcn/ui owned components + Tailwind theme tokens",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
